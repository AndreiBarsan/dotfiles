{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/home/andrei/.config/opencode/AGENTS.md"
  ],
  "compaction": {
      "auto": true,
      "keep": { "tokens": 24000 }
  },
  "provider": {
      "llamacpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp (local)",
            "options": {
                    "baseURL": "http://127.0.0.1:9931",
                    "apiKey": "sk-dummy"
                  },
            "models": {
                    "local-coder": {
                              "name": "Local Coding Model",
                              "limit": {
                                          "context": 81920,
                                          "output": 8192
                                        }
                            }
                  }
          }
    },
  "mcp": {
    "servers": {
      "git": {
        "type": "local",
        "command": ["/home/andrei/.nvm/versions/node/v26.13.0/bin/npx", "-y", "mcp-git"],
        "environment": {
          "PATH": "/home/andrei/.nvm/versions/node/v26.13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        }
      }
    }
  }
}
